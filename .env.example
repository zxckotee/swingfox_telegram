TELEGRAM_SECRET=
TELEGRAM_BOT_SHARED_SECRET=

# Backend switch: on = swingfox.ru :3001, off = staging /stagging :3002
# Production bot on master deploy must use on (users link on swingfox.ru).
PRODUCTION=on

# Persisted JWT sessions in SQLite (docker named volume bot_sessions -> /app/data)
# Do not set SESSION_DB_PATH=/data unless that directory is writable by uid 10001.

# Optional overrides (if unset, chosen automatically from PRODUCTION):
# SWINGFOX_API_URL=https://127.0.0.1:3002/api
# SWINGFOX_UPLOADS_URL=https://swingfox.ru/stagging/uploads
# PUBLIC_WEB_URL=https://swingfox.ru/stagging

# Optional: if api.telegram.org is blocked on the server
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# SWINGFOX_API_VERIFY=false  # auto for 127.0.0.1; set true to enforce cert check

# Backend reconnect during site CI/CD (no time limit; probes run for days)
# BACKEND_PROBE_SECONDS=15
# BACKEND_PROBE_INTERVAL_UP=120
# BACKEND_DOWN_LOG_SECONDS=600
# BACKEND_PROBE_TIMEOUT=8
# POLLING_FATAL_RETRY_SECONDS=10
